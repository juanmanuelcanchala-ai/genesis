# Meta Model API (https://api.meta.ai/v1). Without it, Génesis runs in mock mode.
MODEL_API_KEY=
MODEL_REASONING=low
# WhatsApp Cloud API
WA_TOKEN=
WABA_ID=
WA_APP_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=genesis-verify
WA_INTAKE_PHONE_ID=
WA_CRADLE_PHONE_IDS=
WA_CRADLE_DISPLAY_NUMBERS=
CATALOG_ID=
WA_DRY_RUN=1
# Mercado Pago (sandbox)
MP_ACCESS_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000
# Stage demo
DEMO_OWNER_WA_ID=
# Required with live WhatsApp: guards /api/* (panel: open /#token=<value>)
GENESIS_ADMIN_TOKEN=
# 1 = any failed inspector check blocks the launch (default: one soft miss is a warning)
GENESIS_INSPECTOR_STRICT=0
# Seconds each plan node waits in mock mode so the panel animations are visible (0 = off)
GENESIS_STAGE_DELAY_S=0
